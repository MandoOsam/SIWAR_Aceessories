# Application
NODE_ENV=development
PORT=3000

# Database — Supabase
# DATABASE_URL = pooled connection string (Transaction mode, port 6543) — used by the app
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-xx-xx.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL = direct connection string (port 5432) — used by drizzle-kit migrations only
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-xx-xx.supabase.com:5432/postgres

# Sessions (used starting B2)
SESSION_SECRET=change-me-to-a-long-random-string

# CORS — exact origins of the two frontends
FRONTEND_ORIGIN=https://siwar.example
ADMIN_ORIGIN=https://admin.siwar.example
# Cookie domain for session cookies (B2; e.g. .siwar.example in production, leave empty in dev)
COOKIE_DOMAIN=

# Cloudinary — signed uploads (used starting B3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
