# SIWAR backend npm configuration.
#
# `legacy-peer-deps=true` is required because npm 10.8.x throws
# "Cannot read properties of null (reading 'edgesOut')" while resolving the
# optional peer dependencies of vitest (jsdom / happy-dom / canvas) against
# the configured registry mirror. This makes a clean `npm install` reproducible.
legacy-peer-deps=true
